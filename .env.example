# ============================================================
# Supabase keys — fill these in from:
# Supabase Dashboard → Project Settings → API
# ============================================================

# Project URL (looks like: https://abcdefghijklmnop.supabase.co)
VITE_SUPABASE_URL=

# Project Reference ID (the short id in the URL, e.g. abcdefghijklmnop)
VITE_SUPABASE_PROJECT_REF=

# anon / public key (safe for the website / admin login in the browser)
VITE_SUPABASE_ANON_KEY=

# service_role key (SECRET — never share, never put VITE_ in front of this)
# Use only for trusted server/backend work later. Do not expose in frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: database connection string (Project Settings → Database)
# Only needed if you later connect a Node/server backend directly to Postgres.
# DATABASE_URL=

# ============================================================
# Moolre payments (public checkout keys only)
# Get these from your Moolre dashboard. Never put the secret key in VITE_*.
# After filling on Vercel, redeploy so Pay now can open checkout.
# ============================================================
VITE_MOOLRE_USERNAME=
VITE_MOOLRE_PUBLIC_KEY=
VITE_MOOLRE_ACCOUNT_NUMBER=

# Optional later (server only — do NOT prefix with VITE_)
# MOOLRE_SECRET_KEY=
